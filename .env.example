# Copy this file to .env.local for local development, and add the same
# variables in Vercel → Project → Settings → Environment Variables.
# NEVER commit real values.

# ---------- Your forum (safe to be public; shown in the site) ----------
NEXT_PUBLIC_FORUM_NAME="Our EO Forum"
NEXT_PUBLIC_CHAPTER_NAME="EO Your City"
# Your domain without https://
NEXT_PUBLIC_SITE_DOMAIN=example.com
NEXT_PUBLIC_CONSTITUTION_TITLE="2026–27 Forum Constitution"
# Bump this (e.g. v2) when you adopt a new constitution so members re-sign
NEXT_PUBLIC_CONSTITUTION_VERSION=v1
# Optional: link to your constitution doc (Google Drive "anyone with link" etc.)
NEXT_PUBLIC_CONSTITUTION_URL=
# Officer emails/names (must match the email each person signs in with)
NEXT_PUBLIC_ADMIN_EMAIL=admin@example.com
NEXT_PUBLIC_MODERATOR_EMAIL=
NEXT_PUBLIC_TREASURER_EMAIL=
NEXT_PUBLIC_TREASURER_NAME=
NEXT_PUBLIC_RETREAT_COORDINATOR_NAME=

# ---------- Who may sign in (server only) ----------
# Comma-separated list of every member's email. The admin is always allowed.
ALLOWED_MEMBER_EMAILS=admin@example.com,member2@example.com

# ---------- Clerk (sign-in) — https://dashboard.clerk.com → API Keys ----------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ---------- Neon (database) — https://console.neon.tech → Connection string ----------
# Looks like postgres(ql)://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=

# ---------- One-time seed secret (make up a long random string) ----------
# Used once with POST /api/seed to create the admin member row.
SEED_SECRET=

# ---------- Vercel Blob (file/photo uploads) ----------
# Vercel → Storage → Create Blob store → Connect to project. On Vercel this
# is set automatically. BLOB_READ_WRITE_TOKEN only needed outside Vercel.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# ---------- Google Places (address autocomplete on Events/Retreat) ----------
# https://console.cloud.google.com → enable "Places API (New)" → Credentials → API key.
# Checked in order: GOOGLE_PLACES_API_KEY, GOOGLE_MAPS_API_KEY, NEXT_PUBLIC_GOOGLE_MAPS_API_KEY.
# Prefer the server-only GOOGLE_PLACES_API_KEY.
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---------- Optional: "Report a problem" emails via Resend — https://resend.com/api-keys ----------
RESEND_API_KEY=
BUG_REPORT_TO_EMAIL=
# Use onboarding@resend.dev until you verify your domain in Resend
BUG_REPORT_FROM_EMAIL="Our EO Forum <onboarding@resend.dev>"

# ---------- Optional, advanced: auto-send bug reports to a Cursor agent ----------
CURSOR_AUTOMATION_WEBHOOK_URL=
CURSOR_AUTOMATION_WEBHOOK_KEY=
CURSOR_API_KEY=
# e.g. https://github.com/YOUR-NAME/YOUR-REPO
CURSOR_GITHUB_REPO=
